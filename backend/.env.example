# Required
GROQ_API_KEY=
MISTRAL_API_KEY=

# Required as of Feb 2026 (see BACKEND_SCHEMA doc)
OPENALEX_API_KEY=

# Recommended, optional
SEMANTIC_SCHOLAR_KEY=
CONTACT_EMAIL=you@example.com

# Database — Supabase PostgreSQL (or any Postgres-compatible URL)
# Get this from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) for serverless/cloud deployments.
# Use the "Session" pooler URL (port 5432) for local dev.
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# CORS: comma-separated list of allowed frontend origins.
# Leave unset (or "*") for local dev. In production set to your Vercel URL.
# ALLOWED_ORIGINS=https://marginal.vercel.app

# Frontend env var (set in Vercel dashboard / frontend/.env.local, not here)
# VITE_API_BASE_URL=https://marginal-backend.onrender.com

# LangSmith tracing (https://smith.langchain.com)
# Enable to get full traces of every LangGraph run in the LangSmith UI.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
# All runs appear under this project name in smith.langchain.com
LANGCHAIN_PROJECT=marginal
