# VITE_API_BASE_URL: the Marginal analysis backend (FastAPI + LangGraph).
# Defaults to http://localhost:8000 if unset -- see src/lib/api.ts.
VITE_API_BASE_URL="http://localhost:8000"

# --- Unused, left over from the AI Studio scaffold ---
# @google/genai is not imported anywhere in src/; this app calls the
# Marginal backend above, not the Gemini API directly. Safe to remove
# both of these and the @google/genai dependency in package.json if
# you don't have another use for them.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
